# --- AI brain -------------------------------------------------------------
# ollama (free, runs locally; default) or groq (cloud, needs GROQ_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Base model until one is picked in the dashboard's model switcher:
# qwen3:4b (default, Apache 2.0, 2.5 GB, ~4 GB free RAM: fits a 16 GB server or laptop without a GPU),
# qwen3:8b (Apache 2.0, 5.2 GB, needs ~7 GB free RAM; more accurate, slower on a CPU),
# qwen2.5:3b (fastest, 1.9 GB; research-only license, no commercial use)
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=600
# Thinking for AI calls that do not choose for themselves (chat and summaries use the Think deeper toggle instead)
OLLAMA_THINK=false
# How long the model stays in RAM after a call. Reloading it costs 10-30 s on a laptop.
OLLAMA_KEEP_ALIVE=30m
# AI calls run at the same time (a laptop CPU crawls with more than one)
OLLAMA_MAX_PARALLEL=1

# Optional Groq fallback (LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Troubleshooting agent ---------------------------------------------------
# Default speed: instant (rule checks only, seconds) | fast (checks + one AI pass) | deep (AI investigates further)
DIAGNOSIS_MODE=fast
# Extra investigation rounds the AI may take after the baseline checks (deep mode)
AGENT_MAX_STEPS=3
# Deep thinking for diagnosis reports (the reasoning streams live; adds minutes on a CPU)
DIAGNOSIS_THINKING=true
# Longest one AI call may take during a diagnosis; past it the rule-based diagnosis is shown instead.
# Calls with thinking get the longer limit.
AGENT_AI_TIMEOUT_SECONDS=300
AGENT_AI_TIMEOUT_SECONDS_DEEP=900

# --- Security ------------------------------------------------------------------
# Needed for DELETE /api/agents/{id} (X-Admin-Key header). Add Agent no longer asks for it: the login is enough.
ADMIN_API_KEY=replace_with_a_long_random_admin_key
DASHBOARD_PASSWORD=replace_with_a_separate_dashboard_password
# Run a full AI check-up the first time each device reports
ONBOARDING_CHECK=true
# true: agents enroll with just the install script, no one-time token (trusted LAN only)
OPEN_ENROLLMENT=false
# Address remote agents use when ngrok is off, e.g. http://192.168.1.20 (nginx on port 80)
SENTINEL_PUBLIC_URL=

# --- This server ---------------------------------------------------------------
# The host's name, so its AIops agent is shown as "This server" instead of the container. The deploy workflow
# adds it; set it yourself when you start the stack by hand (run: hostname).
AIOPS_SERVER_HOSTNAME=
# Pin "This server" to one agent when several have the host's name (device id from the Agents tab)
AIOPS_SERVER_DEVICE_ID=
# Thread pools: AI work, and everything else (kept apart so a slow model never stalls the dashboard)
AI_WORKER_THREADS=4
DEFAULT_WORKER_THREADS=16

# --- Self-improving model (see docs/05-self-improving-model.md) ---
LEARNED_MODEL_NAME=aiops-brain
LEARNING_USE_MODEL=true
LEARNING_REBUILD_EVERY=3

# --- Public hosting (nginx + ngrok) ---
# nginx serves the app on port 80; ngrok publishes it on an https URL. Paste your token from
# https://dashboard.ngrok.com/get-started/your-authtoken (without it, ngrok stays off and LAN access still works).
NGROK_AUTHTOKEN=
# Use the live ngrok URL in agent install commands (free URLs change when ngrok restarts)
PUBLIC_URL_FROM_NGROK=true

# --- Decisions log ---
# Folder for every AI decision and approval (JSON + daily index.md). Docker mounts ./decisions here.
DECISIONS_DIR=decisions
